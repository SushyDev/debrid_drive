# RealDebrid API Credentials
# Get your token from: https://real-debrid.com/apitoken
RD_API_TOKEN=your_api_token_here
RD_WEBDAV_PASSWORD=your_webdav_password_here

# Logging Configuration (optional, defaults to info)
# Valid values: debug, info, warning, error
# LOG_LEVEL=info

# Database Configuration (optional, defaults to debrid_stream_#{env}.db)
# DATABASE_PATH=/path/to/database.db

# gRPC Server Configuration (optional, defaults to 50051)
# GRPC_PORT=50051

# Sync Configuration (optional)
# SYNC_POLL_INTERVAL=300000  # milliseconds (5 minutes)
# MAX_REQUESTS_PER_MINUTE=50
